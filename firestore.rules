rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is number;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['amount', 'categoryId', 'date', 'userId']) &&
             data.amount is number &&
             data.categoryId is string &&
             data.date is number &&
             data.userId == request.auth.uid &&
             (data.keys().hasAll(['createdAt']) ? data.createdAt is number : true);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'userId']) &&
             data.name is string &&
             data.userId == request.auth.uid;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'month', 'limit']) &&
             data.userId == request.auth.uid &&
             data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.limit is number && data.limit >= 0;
    }

    // Collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'monthlyBudget', 'currency']);

      match /expenses/{expenseId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpense(incoming()) && isValidId(expenseId);
        allow update: if isOwner(userId) && isValidExpense(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'categoryId', 'date', 'description']);
        allow delete: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(incoming()) && isValidId(categoryId);
        allow update: if isOwner(userId) && isValidCategory(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'icon']);
        allow delete: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBudget(incoming()) && isValidId(budgetId);
        allow update: if isOwner(userId) && isValidBudget(incoming()) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['limit', 'categoryId']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
